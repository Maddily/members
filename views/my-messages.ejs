<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("partials/head") %>
</head>

<body>
  <%- include("partials/header") %>
  <h1>My messages</h1>
  <% if (locals.noMessages) { %>
  <p>No messages yet.</p>
  <% } else { %>
  <% for (const message of messages) { %>
  <article class="message">
    <h2><%= message.title %></h2>
    <p><%= message.text %></p>
    <footer>
      <p>From: <%= message.username %></p>
      <p>Sent: <time datetime="<%= message.created_at.toISOString() %>"><%= message.created_at.toLocaleString() %></time></p>
      <form action="/delete/<%= message.id %>" method="POST">
        <button>Delete</button>
      </form>
    </footer>
  </article>
  <% } %>
  <% } %>
</body>

</html>