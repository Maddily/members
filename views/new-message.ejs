<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("partials/head") %>
</head>

<body>
  <%- include("partials/header") %>
  <main>
    <h1>write a message.</h1>
    <form action="/new-message" method="post">
      <div>
        <label for="title">title</label>
        <input aria-describedby="title-error" type="text" name="title" id="title">
      </div>
      <!-- Display flash error message -->
      <% if (locals.messages.length && messages[0].title) { %>
      <p id="title-error" class="error-msg"><%= messages[0].title %></p>
      <% } %>
      <div class="text">
        <label for="text">message</label>
        <textarea aria-describedby="text-error" name="text" id="text"></textarea>
      </div>
      <!-- Display flash error message -->
      <% if (locals.messages.length && messages[0].text) { %>
      <p id="text-error" class="error-msg"><%= messages[0].text %></p>
      <% } %>
      <footer>
        <button>send</button>
        <a href="/">go to homepage</a>
      </footer>
    </form>
  </main>
  <%- include("partials/footer") %>
</body>

</html>