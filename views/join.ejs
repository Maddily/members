<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("partials/head") %>
</head>

<body>
  <%- include("partials/header") %>
  <main>
    <h1>join the club.</h1>
    <form action="/join" method="post">
      <label for="passcode">
        enter the secret passcode
      </label>
      <input aria-describedby="error" class="<%= locals.messages.length && 'error' %>" type="password" name="passcode" id="passcode" placeholder="••••••••" autocomplete="off" />
      <% if (locals.messages.length) { %>
      <p id="error" class="error-msg"><%= messages[0] %></p>
      <% } %>
      <footer>
        <button>join</button>
        <a href="/">go to homepage</a>
      </footer>
    </form>
  </main>
  <%- include("partials/footer") %>
</body>

</html>