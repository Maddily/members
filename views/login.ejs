<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head") %>
  </head>
  <body>
    <h1>Login</h1>
    <form action="/login" method="post">
      <div class="username">
        <label for="username">Username</label>
        <input
          type="text"
          name="username"
          id="username"
          placeholder="Your username"
        />
      </div>
      <!-- Display flash error message -->
      <% if (locals.messages.length && messages[0].username) { %>
        <p><%= messages[0].username %></p>
      <% } %>
      <div class="password">
        <label for="password">Password</label>
        <input
          type="password"
          name="password"
          id="password"
          placeholder="••••••••"
        />
      </div>
      <!-- Display flash error message -->
      <% if (locals.messages.length && messages[0].password) { %>
        <p><%= messages[0].password %></p>
      <% } %>
      <button>Login</button>
      <p>No account? <a href="/sign-up">Sign up</a></p>
      <p>Forgot your password? <a href="/reset-password">Reset</a></p>
    </form>
  </body>
</html>
