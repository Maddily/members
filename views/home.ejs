<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("partials/head") %>
</head>

<body>
  <%- include("partials/header") %>
  <h1>Messages</h1>
  <% if (locals.noMessages) { %>
  <p>No messages yet.</p>
  <% } else { %>
  <% for (const message of messages) { %>
  <article class="message">
    <h2><%= message.title %></h2>
    <p><%= message.text %></p>
    <footer>
      <p>From: <%= locals.user && (isMemberOrAdmin || message.is_author) ? message.username : "Anonymous" %></p>
      <% if (locals.user && (isMemberOrAdmin || message.is_author)) { %>
      <p>Sent: <time datetime="<%= message.created_at.toISOString() %>"><%= message.created_at.toLocaleString() %></time></p>
      <% } %>
      <% if (message.is_author || user.is_admin) { %>
      <form action="/delete/<%= message.id %>" method="POST">
        <button>Delete</button>
      </form>
      <% } %>
    </footer>
  </article>
  <% } %>
  <% } %>
</body>

</html>