<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("partials/head") %>
</head>

<body>
  <%- include("partials/header") %>
  <main>
    <h1>messages.</h1>
    <% if (locals.noMessages) { %>
    <p class="no-messages">no messages yet. <a class="write-new" href="/new-message">write</a> the first one.</p>
    <% } else { %>
    <% for (const message of messages) { %>
    <article class="message">
      <h2 class="title"><%= message.title %></h2>
      <p class="text"><%= message.text %></p>
      <footer>
        <p class="from">from: <span><%= locals.user && (isMemberOrAdmin || message.is_author) ? message.username : "anonymous" %></span></p>
        <% if (locals.user && (isMemberOrAdmin || message.is_author)) { %>
        <p class="sent">sent: <time datetime="<%= message.created_at.toISOString() %>"><%= message.created_at.toLocaleString() %></time></p>
        <% } %>
        <% if (message.is_author || user.is_admin) { %>
        <form action="/delete/<%= message.id %>" method="POST">
          <button class="delete-btn">delete</button>
        </form>
        <% } %>
      </footer>
    </article>
    <% } %>
    <% } %>
  </main>
</body>

</html>